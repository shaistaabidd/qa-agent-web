# Same keys as function-rx. Copy values from function-rx/.env into .env
# (do not commit .env).

# Backend origin — Apollo uses `${VITE_APP_API_URL}/graphql`
VITE_APP_API_URL=

# ActionCable / subscriptions (when wired)
VITE_WEBSOCKET_URL=

# Frontend origin used for redirects (e.g. billing return)
VITE_REDIRECT_FRONTND_URL=
